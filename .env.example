# ── Postgres ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pos_db
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_ADMIN_PASSWORD=changeme
POSTGRES_APP_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redis

# ── NATS ──────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_USER=pos
NATS_PASSWORD=changeme

# ── Auth / JWT ────────────────────────────────────────────
# Generate with: openssl genrsa -out keys/private.pem 2048
#                openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_RS256_PRIVATE_KEY_PATH=./keys/private.pem
JWT_RS256_PUBLIC_KEY_PATH=./keys/public.pem
JWT_TOKEN_TTL_MINUTES=60

# ── Service-to-service auth ───────────────────────────────
# HMAC-SHA256 shared secret for X-Service-Token header
SERVICE_TOKEN_SECRET=changeme

# ── gRPC service ports ────────────────────────────────────
AUTH_GRPC_PORT=8081
PRODUCT_GRPC_PORT=8082
INVENTORY_GRPC_PORT=8083
SALES_GRPC_PORT=8084
SUPPLIER_GRPC_PORT=8085
CUSTOMER_GRPC_PORT=8086

# Prometheus metrics port (per service: +100 offset)
# auth=9101, product=9102, inventory=9103, sales=9104, supplier=9105, customer=9106

# ── Laravel Gateway ───────────────────────────────────────
APP_URL=http://localhost:8000
APP_KEY=base64:changeme
GATEWAY_PORT=8000

AUTH_SERVICE_URL=http://localhost:8081
PRODUCT_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8083
SALES_SERVICE_URL=http://localhost:8084
SUPPLIER_SERVICE_URL=http://localhost:8085
CUSTOMER_SERVICE_URL=http://localhost:8086

# ── SvelteKit Apps ────────────────────────────────────────
PUBLIC_GATEWAY_URL=http://localhost:8000
ADMIN_PORT=5173
CASHIER_PORT=5174

# ── Observability ─────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=info
ENVIRONMENT=development
